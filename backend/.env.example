# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to version control!

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/secure_file_storage

# ── JWT (generate a strong random secret, min 64 chars) ───────
JWT_SECRET=replace_with_a_long_random_secret_here

# ── AES-256 File Encryption Key (exactly 32 chars recommended) ─
ENCRYPTION_KEY=replace_with_a_32_byte_random_key

# ── Email (Gmail App Password recommended) ────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# ── Server ────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Development Flags ─────────────────────────────────────────
# Set to true to skip ClamAV antivirus scanning (local dev only!)
# NEVER set this to true in production
BYPASS_AV_SCAN_IN_DEV=false
